{
  "ci": {
    "collect": {
      "startServerCommand": "npx wrangler pages dev _site --port 8790 --ip 127.0.0.1",
      "startServerReadyPattern": "Ready on",
      "startServerReadyTimeout": 90000,
      "url": [
        "http://127.0.0.1:8790/dial/",
        "http://127.0.0.1:8790/de/dial/",
        "http://127.0.0.1:8790/ar/dial/",
        "http://127.0.0.1:8790/japanese2k",
        "http://127.0.0.1:8790/overload"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.85 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 3000 }],
        "errors-in-console": "error",
        "is-crawlable": "error",
        "hreflang": "error",
        "canonical": "error",
        "meta-description": "error"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
